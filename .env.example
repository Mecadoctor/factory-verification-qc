# Variables d'environnement — copier vers .env (jamais commité)
# Code d'accès de la page
ACCESS_CODE=wenov
# Clé de signature des sessions (générer une valeur aléatoire en prod)
FLASK_SECRET=changez-moi-en-production
# Token développeur Frame.io (https://developer.frame.io/ → Tokens)
FRAMEIO_TOKEN=
# Compte Frame.io
FRAMEIO_ACCOUNT_ID=4516c658-53a4-4a52-8b5a-d200803ed2d6
# Modèle Whisper faster-whisper (tiny, base, small, medium)
WHISPER_MODEL=small
# Port local
PORT=5057
